{
  "name": "roselite",
  "version": "0.2.0",
  "description": "Open-source desktop companion and overlay for ROSE Online",
  "license": "MIT",
  "author": "DrezByte <72398600+DrezByte@users.noreply.github.com>",
  "homepage": "https://rose-lite.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrezByte/RoseLite.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --config electron-builder.js",
    "release": "electron-builder --win nsis --x64 --config electron-builder.js --publish always",
    "dist:mac": "electron-builder --mac dmg --config electron-builder.js",
    "ship": "npm version patch && git push --follow-tags"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
